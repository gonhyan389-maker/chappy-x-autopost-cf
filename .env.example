# X Developer App (OAuth 2.0 with PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Must exactly match the callback URL configured in X Developer Console.
# Example: https://YOUR-SITE.netlify.app/api/x-auth-callback
X_REDIRECT_URI=

# Protects the private admin API/UI. Generate a long random string.
ADMIN_SECRET=

# Optional label shown in the UI
APP_OWNER=reiya

# note auto-post (uses note.com's unofficial internal API)
NOTE_AUTOPUBLISH_ENABLED=false
NOTE_URLNAME=libertas_reiya

# Prefer NOTE_SESSION_COOKIE when possible. Otherwise set login credentials.
# Keep all of these as secret environment variables; never commit real values.
NOTE_SESSION_COOKIE=
NOTE_EMAIL=
NOTE_PASSWORD=

# OpenAI article generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional: announce a newly published note on X using the existing X connection.
NOTE_X_ANNOUNCE_ENABLED=false
